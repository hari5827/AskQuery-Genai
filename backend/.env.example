# --- Auth ---
JWT_SECRET=

# --- Gmail OAuth2 (for sending verification emails) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER=

# --- AI / Vector / Search providers ---
ASKQUERY_API_KEY=      # Google Gemini API key
MISTRAL_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=