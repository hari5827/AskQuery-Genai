# --- Server ---
PORT=3000
NODE_ENV=development
# URL of your deployed frontend (used for CORS + Socket.io in production)
# e.g. https://askquery.vercel.app
FRONTEND_URL=

# --- Database & Cache ---
mongo_uri=
