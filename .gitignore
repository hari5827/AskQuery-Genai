# --- Dependencies ---
node_modules/
backend/node_modules
frontend/node_modules

# --- Environment variables (NEVER commit real secrets) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# --- Build output ---
frontend/dist
frontend/build
backend/dist

# --- Uploaded files (user PDFs shouldn't be committed) ---
backend/src/uploads/*
!backend/src/uploads/.gitkeep

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db

# --- Test / coverage ---
coverage/

# --- Vite cache ---
frontend/.vite

# --- Misc ---
*.tmp